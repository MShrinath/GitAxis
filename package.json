{
  "name": "gitaxis",
  "displayName": "GitAxis - Git & GitHub Profile Manager",
  "description": "Multi-profile Git and GitHub control center for VS Code. Switch work & personal accounts, automate folder routing, and isolate credentials.",
  "version": "0.14.0",
  "type": "commonjs",
  "license": "MIT",
  "pricing": "Free",
  "badges": [
    {
      "url": "https://github.com/MShrinath/GitAxis/actions/workflows/ci.yml/badge.svg",
      "href": "https://github.com/MShrinath/GitAxis/actions/workflows/ci.yml",
      "description": "CI Status"
    }
  ],
  "publisher": "mshrinath",
  "icon": "media/icon.png",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "GitAxis executes Git commands and alters credentials, which requires a trusted workspace."
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MShrinath/GitAxis"
  },
  "homepage": "https://github.com/MShrinath/GitAxis#readme",
  "bugs": {
    "url": "https://github.com/MShrinath/GitAxis/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "github",
    "profile",
    "git-profile",
    "identity",
    "account-manager",
    "profile-switcher",
    "multi-account",
    "multi-profile",
    "credentials",
    "ssh",
    "ssh-agent",
    "gitconfig",
    "work-personal"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitaxis-sidebar",
          "title": "GitAxis",
          "icon": "media/gitaxis-icon.svg"
        }
      ]
    },
    "views": {
      "gitaxis-sidebar": [
        {
          "type": "webview",
          "id": "gitaxis.sidebarView",
          "name": "Control Center"
        }
      ]
    },
    "commands": [
      {
        "command": "gitaxis.open",
        "title": "Open Control Center",
        "category": "GitAxis"
      },
      {
        "command": "gitaxis.switchProfile",
        "title": "Switch Profile",
        "category": "GitAxis"
      },
      {
        "command": "gitaxis.showEffectiveIdentity",
        "title": "Show Effective Identity",
        "category": "GitAxis"
      },
      {
        "command": "gitaxis.configureFolderRules",
        "title": "Configure Folder Rules",
        "category": "GitAxis"
      },
      {
        "command": "gitaxis.removeAllConfig",
        "title": "Remove All GitAxis Config",
        "category": "GitAxis"
      },
      {
        "command": "gitaxis.verifyAccount",
        "title": "Verify Profile Authentication",
        "category": "GitAxis"
      },
      {
        "command": "gitaxis.createProfile",
        "title": "Create Profile",
        "category": "GitAxis"
      },
      {
        "command": "gitaxis.manageProfiles",
        "title": "Manage Profiles",
        "category": "GitAxis"
      },
      {
        "command": "gitaxis.scanAccounts",
        "title": "Scan Existing Accounts",
        "category": "GitAxis"
      }
    ],
    "keybindings": [
      {
        "command": "gitaxis.switchProfile",
        "key": "ctrl+alt+g",
        "win": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      },
      {
        "command": "gitaxis.switchProfile",
        "key": "alt+g",
        "win": "alt+g",
        "mac": "alt+g",
        "when": "!terminalFocus"
      }
    ],
    "configuration": {
      "title": "GitAxis",
      "properties": {
        "gitaxis.advanced.allowGlobalScope": {
          "type": "boolean",
          "default": false,
          "description": "Advanced: Show global Git identity scope option when creating profiles. Affects system-wide ~/.gitconfig."
        },
        "gitaxis.guard.mode": {
          "type": "string",
          "enum": [
            "block",
            "warn",
            "off"
          ],
          "default": "warn",
          "description": "Commit and push safety guard mode: block mismatched operations, warn with actions, or disable."
        },
        "gitaxis.autoDetectProfile": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect and prompt to switch profile based on repository remote and configuration."
        },
        "gitaxis.promptScanOnFirstLaunch": {
          "type": "boolean",
          "default": true,
          "description": "Prompt to scan system Git and GitHub CLI configurations on first launch."
        },
        "gitaxis.confirmDestructiveOperations": {
          "type": "boolean",
          "default": true,
          "description": "Require explicit confirmation for destructive Git operations (e.g. force push, reset --hard)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./",
    "typecheck": "tsc --noEmit",
    "test": "mocha -r ts-node/register/transpile-only \"test/**/*.test.ts\"",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.24",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "mocha": "^10.8.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "serialize-javascript": "^7.1.3"
  },
  "galleryBanner": {
    "color": "#0D1117",
    "theme": "dark"
  }
}